{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!dist", "!build", "!.next", "!node_modules", "!src/theme/theme-vars.css"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 150,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off"
			},
			"a11y": {
				"recommended": false,
				"useKeyWithClickEvents": "off",
				"noSvgWithoutTitle": "off"
			},
			"complexity": {
				"noForEach": "off",
				"noImportantStyles": "off"
			},
			"style": {
				"noDescendingSpecificity": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "asNeeded"
		}
	}
}
