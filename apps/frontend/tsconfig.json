{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ESNext", // Target version of the compiled code（ECMAScript).
		"module": "ESNext", // The type of module system used. ESNext supports more features, such as dynamic imports.
		"lib": ["ESNext", "DOM", "DOM.Iterable"], // The library files to include. The DOM, DOM.Iterable, and ESNext libraries are fundamental dependencies in TypeScript development.
		"useDefineForClassFields": true,
		"skipLibCheck": true, // Skip compiler checks on imported library files to speed up the build process.
		"allowJs": true, // Allow compiling JavaScript files
		/* Bundler mode */
		"moduleResolution": "bundler",
		"sourceMap": true, // Outputting *.map files provides source code mapping.
		"declaration": false, // Whether to generate a declaration file (.d.ts). tránh lỗi khi import from backend
		"declarationMap": false,
		"preserveWatchOutput": true, // This option allows previously compiled files to be retained in monitoring mode, thus avoiding recompilation caused by deleting changed files during incremental compilation.
		"removeComments": true, // Whether to remove comments. This can improve compilation speed and reduce the size of the generated files.
		"allowImportingTsExtensions": true, // It allows importing modules with the .ts or .tsx extension in the import statement without requiring the extension to be explicitly specified.
		"resolveJsonModule": true, // Allow importing json module
		"isolatedModules": true, // This allows TypeScript to process each file as an independent unit (which can speed up compilation).
		"noEmit": true, // The compiler does not generate any JS files.
		"jsx": "react-jsx",
		// This improves TypeScript's compatibility with CommonJS modules. When using the CommonJS module system, exported modules are wrapped in an object because CommonJS uses syntax similar to `module.exports` to export modules.
		// Some tools and libraries may need to import these CommonJS modules as ES6 modules, in which case the esModuleInterop option can be enabled.
		// Once enabled, you no longer need to use the default export to import CommonJS modules correctly, nor do you need to manually handle require() and module.exports.
		// This makes the process of importing and using CommonJS modules much simpler and more convenient.
		"esModuleInterop": true,
		/* Linting */
		"strict": true, // Enable all strict type checking options
		"strictNullChecks": true, // Strictly check null values
		"noImplicitAny": true, // Implicit any type is prohibited
		"noUnusedLocals": true, // Eliminate warnings generated by unused variables
		"noUnusedParameters": true, // Eliminate warnings generated by unused parameters
		"noFallthroughCasesInSwitch": true, // Avoid falling into traps with switch statements
		"useUnknownInCatchVariables": false // When true, variables declared in a catch block will be treated as unknown instead of the default any.
	},
	"include": ["src", "types", "tailwind.config.ts"],
	"exclude": ["node_modules", "dist"]
}
