{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["**", "!dist", "!build", "!.next", "!node_modules", "!migrations", "!src/routes-types.ts"]
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 150,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"indentWidth": 2,
			"semicolons": "always",
			"arrowParentheses": "asNeeded"
		}
	}
}
