{
	"name": "xdev-template",
	"private": true,
	"scripts": {
		"dev": "bun --filter \"*\" dev",
		"dev:backend": "bun --filter backend dev",
		"dev:frontend": "bun --filter frontend dev",
		"build": "bun --filter \"*\" build",
		"lint": "bun --filter 'backend' --filter 'frontend' lint",
		"lint:fix": "bun --filter 'backend' --filter 'frontend' lint:fix",
		"lintbe": "bun --filter backend lint",
		"lintfe": "bun --filter frontend lint",
		"lint:be": "bun --filter backend lint",
		"lint:fe": "bun --filter frontend lint",
		"typecheck": "bun --filter \"*\" typecheck",
		"typecheckbe": "bun --filter backend typecheck",
		"typecheckfe": "bun --filter frontend typecheck",
		"typecheck:be": "bun --filter backend typecheck",
		"typecheck:fe": "bun --filter frontend typecheck",
		"db:generate": "bun --filter backend db:generate",
		"db:migrate": "bun --filter backend db:migrate",
		"db:push": "bun --filter backend db:push",
		"db:init": "bun --cwd apps/backend src/initDB.ts",
		"routes:generate": "bun scripts/generate-routes-types.ts",
		"routes:types": "bun scripts/generate-routes-types.ts",
		"routes:watch": "bun scripts/generate-routes-types.ts --watch"
	},
	"workspaces": {
		"catalog": {
			"@types/react": "^18.2.28",
			"@types/react-dom": "^18.2.13",
			"react": "^18.2.0",
			"react-dom": "^18.2.0",
			"elysia": "1.4.15",
			"@elysiajs/eden": "^1.4.5",
			"@types/bun": "^1.3.4",
			"@biomejs/biome": "^2.3.8",
			"@types/node": "^22.10.5",
			"bun-types": "^1.3.4",
			"typescript": "^5.7.2",
			"esbuild-plugin-autoload": "^0.3.3"
		},
		"packages": ["packages/*", "apps/*"]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14"
	}
}
